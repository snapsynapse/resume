{
  "name": "sam-rogers-resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-static-html.mjs && node scripts/validate-metadata.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.mjs",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "refresh:ai-usage": "node scripts/fetch-ai-usage.mjs",
    "eval:ats-artifact": "node scripts/eval-ats-artifact.mjs",
    "eval:audit": "vitest run src/test/audit-api-regressions.test.ts src/test/stream-transport.test.ts src/test/typecheck-gate.test.ts src/test/refresh-gate.test.ts src/lib/analytics.test.ts src/components/AIChat.test.tsx src/components/FitAssessment.test.tsx",
    "eval:prompts": "node scripts/eval-prompts.mjs",
    "presets:validate": "node scripts/role-context-presets.mjs validate",
    "presets:env": "node scripts/role-context-presets.mjs env",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:watch": "vitest",
    "eval:recruiter": "node scripts/eval-recruiter.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "posthog-js": "^1.373.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "@tailwindcss/postcss": "^4.3.3"
  }
}
