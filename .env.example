# Server-side only. NEVER prefix with VITE_ — that would bundle the key into the public JS.
# Set this in the Vercel project dashboard under Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Server-side only. NEVER prefix with VITE_ — the presets name employers and carry prompt
# text that must not ship in the public bundle. Leave both unset for a neutral site.
# ROLE_CONTEXT_PRESETS holds the raw JSON (production: set it with `vercel env add`, see
# README "Target and company routing"). ROLE_CONTEXT_PRESETS_FILE is a local-dev path
# alternative, for example private/role-context-presets.json (`private/` is gitignored for
# that purpose). The inline value wins when both are set. Validate with
# `npm run presets:validate -- <file>` before deploying.
ROLE_CONTEXT_PRESETS=
ROLE_CONTEXT_PRESETS_FILE=

# Client-side, public analytics config. PostHog is initialized in cookieless mode,
# with autocapture and session replay disabled.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
